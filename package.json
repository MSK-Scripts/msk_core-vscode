{
  "name": "msk-core-lua",
  "displayName": "MSK Core (FiveM) IntelliSense",
  "description": "IntelliSense, autocompletion and types for the MSK.* API of the msk_core library (FiveM).",
  "version": "1.3.0",
  "publisher": "musiker15",
  "author": {
    "name": "Moritz Kohm (MSK Scripts)",
    "url": "https://www.msk-scripts.de"
  },
  "license": "MIT",
  "pricing": "Free",
  "homepage": "https://www.msk-scripts.de",
  "bugs": {
    "url": "https://github.com/MSK-Scripts/msk_core-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MSK-Scripts/msk_core-vscode"
  },
  "engines": {
    "vscode": "^1.71.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "Lua",
    "FiveM",
    "CfxLua",
    "MSK",
    "msk_core",
    "ESX",
    "QBCore",
    "IntelliSense"
  ],
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#0a0b0d",
    "theme": "dark"
  },
  "extensionDependencies": [
    "sumneko.lua"
  ],
  "activationEvents": [
    "onLanguage:lua"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:uninstall": "node ./uninstall.js"
  },
  "contributes": {
    "configuration": {
      "title": "MSK Core",
      "properties": {
        "mskCore.enableLibrary": {
          "type": "boolean",
          "default": true,
          "description": "Adds the MSK.* definitions to Lua.workspace.library."
        },
        "mskCore.setRuntime": {
          "type": "boolean",
          "default": true,
          "description": "Sets Lua.runtime.version to Lua 5.4 for workspaces containing a fxmanifest.lua, unless the workspace already defines a runtime."
        }
      }
    },
    "commands": [
      {
        "command": "mskCore.reload",
        "title": "Reload definitions",
        "category": "MSK Core"
      },
      {
        "command": "mskCore.showLibraryPath",
        "title": "Show definitions path",
        "category": "MSK Core"
      }
    ]
  }
}
